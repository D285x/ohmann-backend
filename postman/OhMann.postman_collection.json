            }
          }
        },
        {
          "name": "Delete vehicle",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/vehicles/5"
          }
        },
        {
          "name": "Refine aerodynamics (aero-service)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/vehicles/1/aero/refine",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"noseFinenessRatio\": 3.0,\n  \"machMin\": 0.3,\n  \"machMax\": 5.0,\n  \"points\": 24\n}"
            }
          }
        },
        {
          "name": "Reset aerodynamics to constant Cd",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/vehicles/1/aero"
          }
        }
      ]
