        },
        {
          "name": "Get vehicle 1",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/vehicles/1"
          }
        },
        {
          "name": "Create vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/vehicles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SSLV\",\n  \"manufacturer\": \"ISRO\",\n  \"country\": \"India\",\n  \"diameterM\": 2.0,\n  \"dragCoefficient\": 0.3,\n  \"stages\": [\n    { \"name\": \"SS1\", \"propellantMassKg\": 87000, \"dryMassKg\": 12000, \"thrustKn\": 2100, \"ispS\": 250 },\n    { \"name\": \"SS2\", \"propellantMassKg\": 7700, \"dryMassKg\": 1600, \"thrustKn\": 240, \"ispS\": 280 },\n    { \"name\": \"SS3\", \"propellantMassKg\": 4500, \"dryMassKg\": 900, \"thrustKn\": 160, \"ispS\": 290 },\n    { \"name\": \"VTM\", \"propellantMassKg\": 50, \"dryMassKg\": 100, \"thrustKn\": 0.1, \"ispS\": 200 }\n  ]\n}"
            }
          }
        },
        {
