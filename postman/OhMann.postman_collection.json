{
  "info": {
    "name": "OhMann (ESE3104)",
    "description": "REST API tests for the OhMann Spring Boot backend. Start the backend on port 8080 first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    }
